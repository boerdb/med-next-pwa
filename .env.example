# Kopieer naar .env.local op de server:
#   cp .env.example .env.local
#   nano /var/www/med-track-pwa/.env.local
#
# Next.js en MySQL draaien op dezelfde machine (192.168.1.14).
# Gebruik NOOIT de MySQL-root user in de app — alleen de medtracker-user.

# MySQL (lokaal op dezelfde server)
DATABASE_URL=mysql://medtracker:JOUW_DB_WACHTWOORD@127.0.0.1:3306/medtracker

# Minimaal 32 tekens. Op de server genereren:
#   openssl rand -base64 32
SESSION_SECRET=JOUW_LANGE_RANDOM_STRING_MIN_32_TEKENS

# Productie achter Cloudflare Tunnel (HTTPS)
NODE_ENV=production

# Optioneel: poort (standaard 3000 voor pm2 / cloudflared)
# PORT=3000
