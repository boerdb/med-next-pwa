# Kopieer naar .env.local op de Next.js-server:
#   cp .env.example .env.local
#   nano /var/www/med-next-pwa/.env.local
#
# Next.js: server NEXT (192.168.1.32) — map /var/www/med-next-pwa
# MySQL:  server DB-server (192.168.1.14) — database medtracker

# MySQL op de DB-server (niet root gebruiken in de app)
DATABASE_URL=mysql://medtracker:JOUW_DB_WACHTWOORD@192.168.1.14:3306/medtracker

# Minimaal 32 tekens:
#   openssl rand -base64 32
SESSION_SECRET=JOUW_LANGE_RANDOM_STRING_MIN_32_TEKENS

NODE_ENV=production
APP_TIMEZONE=Europe/Amsterdam

# Web Push (meldingen als de app gesloten is) — genereer met: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:med@clvs.nl

# Beveiliging voor /api/cron/check-reminders (cron elke minuut)
CRON_SECRET=
